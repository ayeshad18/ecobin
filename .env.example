# EcoBin Environment Configuration Template
# Duplicate this file as .env.local to customize your deployment

# ThingSpeak IoT Telemetry Channel
VITE_THINGSPEAK_CHANNEL_ID=2548912
VITE_THINGSPEAK_READ_KEY=

# Firebase Web App Credentials (Optional - can also be configured in src/services/firebaseConfig.js)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
